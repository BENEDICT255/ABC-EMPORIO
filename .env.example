# ABC EMPORIO SHOW & TELL EXPERIENCE — ENVIRONMENT CONFIGURATION
# Copy to .env.local for local testing or configure in Vercel Project Settings > Environment Variables

# 1. Neon Postgres Connection String (Provisioned via Vercel Marketplace Neon integration)
DATABASE_URL="postgres://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Organiser Export Authorization Token (Protects attendee export endpoint /api/export)
ORGANISER_EXPORT_TOKEN="ABC_SHOWTELL_2026"

# 3. EasyMail API Configuration (Verified Gmail SMTP sender: ABC Emporio Events <abc.showtell.events@gmail.com>)
EASYMAIL_API_KEY="your_easymail_api_key_here"
EASYMAIL_API_URL="https://easymail-nu.vercel.app/api/v1/emails"

# 4. Canonical Website URL
SITE_URL="https://showandtell.abcemporio.com"

